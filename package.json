{
  "name": "html-video-base",
  "version": "2.7.2",
  "type": "module",
  "description": "Minimal, universal, extensible pure-function timeline HTML video framework & multi-TTS rendering toolchain",
  "license": "MIT",
  "keywords": [
    "html-video",
    "timeline",
    "pure-function",
    "interactive-video",
    "tts",
    "subtitle",
    "presentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyusong10/html-video-base.git"
  },
  "homepage": "https://github.com/huyusong10/html-video-base#readme",
  "bugs": {
    "url": "https://github.com/huyusong10/html-video-base/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bin": {
    "html-video": "./bin/html-video.mjs"
  },
  "exports": {
    ".": "./runtime/base/js/index.mjs",
    "./cli": "./tools/cli.mjs",
    "./bundler": "./tools/bundle.mjs",
    "./paths": "./tools/lib/paths.mjs",
    "./skill": "./skills/html-video/SKILL.md",
    "./readme": "./README.md",
    "./readme.en": "./README.en.md",
    "./runtime/engine": "./runtime/base/js/engine.js",
    "./runtime/css": "./runtime/base/css/base.css"
  },
  "files": [
    "bin",
    "runtime",
    "skills",
    "templates",
    "tools",
    "requirements.txt",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "assemble": "node tools/assemble-engine.mjs",
    "lint:cc": "node tools/check-complexity.mjs",
    "test": "node tools/assemble-engine.mjs --check && node tools/check-complexity.mjs && node tools/self-test.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.51.0"
  }
}
